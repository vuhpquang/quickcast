<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>QuickcastURLScheme</key>
	<string>$(QUICKCAST_URL_SCHEME)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Raycast and Quickcast URL Scheme</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>raycast</string>
				<string>$(QUICKCAST_URL_SCHEME)</string>
				<string>com.raycast</string>
			</array>
		</dict>
	</array>
	<!-- Exported, but deliberately no CFBundleDocumentTypes: claiming the type would make a
	     double-clicked .quickcast launch straight into writing over someone's data. The identifier
	     is fixed rather than per-channel so Dev and stable can read each other's exports. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.vuhpquang.quickcast.backup</string>
			<key>UTTypeDescription</key>
			<string>Quickcast Backup</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.archive</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>quickcast</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSAutoFillRequiresTextContentTypeForOneTimeCodeOnMac</key>
	<true/>
	<key>NSAppleEventsUsageDescription</key>
	<string>Quickcast uses automation to perform system actions you explicitly run.</string>
	<key>NSCameraUsageDescription</key>
	<string>Quickcast shows a camera preview so you can check yourself, and take a photo to the clipboard.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Quickcast records audio only while you use Dictation, to transcribe it on your Mac.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Quickcast accesses your events to show your schedule and let you join meetings.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>Quickcast lets extensions you run read and edit your reminders.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Quickcast uses Bluetooth access only when you run the Toggle Bluetooth action.</string>
	<key>NSHumanReadableCopyright</key>
	<string>Quickcast</string>
	<key>QuickcastUpdatePublicKey</key>
	<string>CSzrQKht5GxZW2nVLbWEunvUChqDkeFLP64xSQRWN9E=</string>
</dict>
</plist>
